# Copy to .env and fill in real values. Never commit the real .env file.

# Shared secret expected in the X-API-Key header on every /api/v1/* call.
NUIT_BLANCHE_API_KEY=change-me

# Separate HMAC secret used to sign browser-openable ZIP download URLs.
NUIT_BLANCHE_DOWNLOAD_URL_SECRET=change-me-too

# Signed download URL lifetime in seconds. Default: 24 hours.
NUIT_BLANCHE_DOWNLOAD_URL_TTL_SECONDS=86400

# Max size (bytes) of an incoming JSON body. Default: ~2 MB.
NUIT_BLANCHE_MAX_PAYLOAD_BYTES=2000000

# Hard timeout (seconds) for one carousel generation.
NUIT_BLANCHE_GENERATION_TIMEOUT_SECONDS=60

# Root directory where LocalStorageProvider writes generated files.
NUIT_BLANCHE_GENERATED_DIR=generated

# Instagram portrait canvas size. Do not change without checking the templates.
NUIT_BLANCHE_SLIDE_WIDTH=1080
NUIT_BLANCHE_SLIDE_HEIGHT=1350

NUIT_BLANCHE_LOG_LEVEL=INFO
NUIT_BLANCHE_APP_VERSION=0.1.0
